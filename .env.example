# Copy to .env and fill in real values to enable real email sending / production settings.
# Leave .env absent (or these unset) to keep the current local-dev behavior.

# Required for any real deployment - generate a fresh one, e.g. via
# `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
SECRET_KEY=replace-with-a-real-generated-secret-key

# Must be False for any real deployment - leave unset (or True) for local dev.
DEBUG=False

# Comma-separated, e.g. lu-sims.example.com,www.lu-sims.example.com
ALLOWED_HOSTS=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@your-domain.com
